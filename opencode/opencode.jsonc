{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vllm",
      "options": {
        "baseURL": "http://192.168.1.103:8000/v1"
      },
      "models": {
        "google/gemma-4-E4B-it": {
          "name": "gemma4",
          "limit": {
            "context": 32675,
            "output": 4096
          }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llamacpp",
      "options": {
        "baseURL": "http://192.168.1.201:9000/v1"
      },
      "models": {
        "qwen": {
          "name": "Qwen3.8-27B-Uncensored-Q4_K_M.gguf",
          "limit": {
            "context": 56832,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "llamacpp/qwen",
  "mcp": {
    "home-assistant": {
      "type": "local",
      "command": ["uv", "--project", "/home/mehays/projects/homelab/lib/python/home-assistant-mcp", "run", "home-assistant-mcp"],
      "cwd": "/home/mehays/projects/homelab/lib/python/home-assistant-mcp",
      "enabled": true,
      "timeout": 30000
    }
  }
